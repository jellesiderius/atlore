NODE_ENV=development
ORIGIN=http://localhost:3000
# Komma-gescheiden extra publieke origins, bijvoorbeeld een previewdomein.
TRUSTED_ORIGINS=
PORT=3000
APP_PORT=3000
DATABASE_URL=postgres://atlore:replace-with-a-strong-database-password@localhost:55432/atlore
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_PORT=55432
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379
SESSION_COOKIE_NAME=atlore_session
SESSION_TTL_DAYS=30
REALTIME_SECRET=replace-with-at-least-32-random-characters
STORAGE_PATH=./storage
MAX_UPLOAD_MB=12
S3_ENDPOINT=http://localhost:9000
S3_REGION=eu-west-1
S3_BUCKET=atlore
S3_ACCESS_KEY=atlore
S3_SECRET_KEY=atlore-development-secret
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Atlore <noreply@atlore.local>
LOG_LEVEL=info
